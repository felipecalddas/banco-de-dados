CREATE DATABASE AULA_NOITE4;

USE AULA_NOITE4;

CREATE TABLE empregado (
   matricula INT primary key,
   nome VARCHAR(100) not null,
   cpf	VARCHAR(14) UNIQUE,
   salario DECIMAL(10,2) not null
);

